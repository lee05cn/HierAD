# HierAD 配置示例
# 复制为项目根目录 config.yaml 并修改，或使用环境变量覆盖
#
# 默认全部走本机服务（与 VD-agent / services/registry.yaml 对齐）。
# 某一环要上云时，只改对应 provider，其它环仍用本地。

# VLM（Stage 1 场景描述）
vlm:
  provider: "local"              # local | dashscope
  url: "http://localhost:8002"
  type: "qwen2.5-vl"             # qwen2.5-vl | video-xl2 | videollama3
  endpoint: "/prompted_inference"
  # DashScope 时生效：
  # model: "qwen3-vl-plus"
  # fps: 1.0
  # max_frames: 16

# LLM（Stage1 增强 / Stage3 / 翻译）
llm:
  provider: "local"              # local | dashscope
  base_url: "http://127.0.0.1:8014/v1"
  model: "llama3-8b"
  api_key: "EMPTY"
  # DashScope 时：model: "qwen-plus"，api_key 可用 DASHSCOPE_API_KEY

# ASR（Whisper HTTP；HierAD 默认不做说话人分离）
asr:
  provider: "local"              # local | dashscope
  url: "http://127.0.0.1:8001/asr_recognize"
  diarize: false
  # DashScope 时: model: "fun-asr-realtime"

# CosyVoice TTS（AD 旁白）
tts:
  provider: "local"              # local | dashscope
  url: "http://127.0.0.1:8003"
  spk_id: "英文男"
  speed: 1.2
  voice_name: "康辉"             # 仅本机 CosyVoice / VD-agent 音色库
  # DashScope 时:
  # cloud_voice: "longxiaochun"
  # model: "cosyvoice-v3-flash"

# 百炼（仅 provider=dashscope 的环节会用到）
# dashscope:
#   api_key: ""                  # 或环境变量 DASHSCOPE_API_KEY
#   base_url: "https://dashscope.aliyuncs.com/compatible-mode/v1"

# TMDB（演员数据库）
tmdb:
  api_key: ""  # 或设置 HIERAD_TMDB_API_KEY
  # 服务器无法直连外网：在你电脑 SSH 配置 RemoteForward 7897 127.0.0.1:7897
  # proxy: "http://127.0.0.1:7897"

paths:
  actor_databases: "./actor_databases"
  work_dir: "./work_dir"
